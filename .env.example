SECRET_KEY=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
PUBLIC_BASE_URL=https://urlaub.extrahelden.de
# Optional; ohne Angabe wird beim ersten Start ein Zufallspasswort protokolliert.
INITIAL_ADMIN_PASSWORD=

# Eigener ausgehender E-Mail-Zustelldienst
MAIL_FROM=noreply@extrahelden.de
MAIL_HOSTNAME=mail.extrahelden.de
DKIM_SELECTOR=urlaubsplaner
DKIM_PRIVATE_KEY=instance/dkim_private.pem
MAIL_WORKER_INTERVAL=10
MAIL_MAX_ATTEMPTS=8
# Verhindert die Nutzung einer IPv6-Absenderadresse ohne passenden PTR-Record.
MAIL_IPV4_ONLY=true
