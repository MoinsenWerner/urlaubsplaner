SECRET_KEY=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
PUBLIC_BASE_URL=https://urlaub.extrahelden.de
# Optional; ohne Angabe wird beim ersten Start ein Zufallspasswort protokolliert.
INITIAL_ADMIN_PASSWORD=

# Cloudflare Email Sending (SMTP-Passwort = API-Token mit Email Sending: Edit)
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USERNAME=api_token
SMTP_PASSWORD=cloudflare-api-token-bitte-geheim-halten
SMTP_STARTTLS=false
SMTP_SSL=true
MAIL_FROM=noreply@extrahelden.de
